# Server
ADDR=:8080
WORLD_DATE=1996-08-26
# Allow verified real-world period proper nouns/events to enter generated BBS content.
# Keep OFF while evaluating fictional-world prose without historical-reference mixing.
HISTORICAL_REFERENCES_ENABLED=0

# DEBUG ONLY: bypass BBS root-title Historical KB/Web verification and the
# verified-specific-referent quota. Claim-bearing titles may be adopted unchecked.
# Never enable this as a production correctness setting.

# DEBUG ONLY: log the final validated canonical Article Detail payload before
# persistence so grounding failures can be separated from prose-worker failures.
DEBUG_LOG_BBS_ARTICLE_DETAILS=0

# Log committed, world-generated headers/Situations and lazy bodies to Render
# for generator-quality inspection. Applies only to hosts selected by their
# station flags; never includes human posts.
DEBUG_LOG_GENERATED_CONTENT=1

# EVALUATION ONLY: capture exact model prompts and raw responses in a
# bounded in-memory trace, viewable without a token from the browser inspector.
# CAUTION: this read-only endpoint is publicly reachable on a public deployment;
# model prompts can include thread/persona context and quoted human posts.
# Set 0 before real users join. Destructive reset/sample APIs still require
# DEBUG_RESET_TOKEN and are NOT affected by this flag.
DEBUG_GENERATION_TRACE=1

# Reversible title-led prose experiment for hosts selected by their station
# flags. Skip optional Article Detail/research model calls; keep Situation/title
# planning and canonical stored posts unchanged. Set to 0 to restore old body
# prompt and detail/evidence steps for new materialization attempts.
GENERATION_FREEFORM_BODY=1

# Required when creating a new generated world.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=
# This must match the GPT-6 Luna deployment name in the Azure resource.
AZURE_OPENAI_MODEL=zutto-pccom-gpt-6-luna
# Used only by the optional image-generation PoC; deploy this model separately to use it.

# PostgreSQL is the canonical store for generated worlds and host catalogs.
DATABASE_URL=postgres://zutto:zutto@localhost:5432/zutto?sslmode=disable

# Optional. When non-empty, enables destructive debug reset endpoints.
# Send the same value in the X-Zutto-Debug-Token header. Never expose this as
# a VITE_ variable because Vite variables are shipped to the browser.
DEBUG_RESET_TOKEN=

# Web
VITE_WS_URL=ws://localhost:8080/ws
VITE_WORLD_DATE=1996-08-26
# Up to two comma-separated pseudo Telehodai destinations.
VITE_TELEHODAI_NUMBERS=0920000196

# Deprecated aliases (still read when the new name is unset; remove in a later release):
#   DEBUG_LOG_HAKATA_GENERATED -> DEBUG_LOG_GENERATED_CONTENT
#   DEBUG_HAKATA_LLM_TRACE     -> DEBUG_GENERATION_TRACE
#   HAKATA_FREEFORM_BODY       -> GENERATION_FREEFORM_BODY
