{
  "name": "zutto-pccom-prototype",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "go -C apps/server run ./cmd/server",
    "dev:web": "npm --prefix apps/web run dev",
    "test": "npm run test:server && npm run test:web",
    "test:server": "go -C apps/server test ./...",
    "test:web": "npm --prefix apps/web test",
    "build": "npm run test:server && npm --prefix apps/web run build"
  },
  "engines": {
    "node": ">=22"
  }
}
